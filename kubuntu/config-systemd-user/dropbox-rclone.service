[Unit]
Description=Rclone Dropbox mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/rclone mount dropbox: %h/Dropbox-cloud \
    --vfs-cache-mode full \
    --vfs-cache-max-size 5G \
    --exclude '**/.~lock.*' \
    --exclude '**/.DS_Store' \
    --exclude '**/*~' \
    --exclude '**/Thumbs.db' \
    --exclude '**/~$*' \
    --exclude '**/.directory'
ExecStop=/bin/fusermount3 -u %h/Dropbox-cloud
Restart=on-failure

[Install]
WantedBy=default.target
